# Build environment for the Snow Launcher AppImage: Ubuntu 24.04, the
# minimum base (GTK 4.14, libadwaita 1.5, glibc 2.39), so the AppImage runs
# on it and on anything newer. Tools are pinned and checked.
FROM docker.io/library/ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config ca-certificates curl gnupg \
      libgtk-4-dev libadwaita-1-dev squashfs-tools desktop-file-utils \
 && rm -rf /var/lib/apt/lists/*

# Rust through rustup-init at a fixed version, checked against its
# published SHA-256 before it runs; the toolchain is fixed too.
ARG RUSTUP_VERSION=1.28.2
ARG RUST_TOOLCHAIN=1.88.0
RUN base="https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu" \
 && curl -fsSLo /tmp/rustup-init "${base}/rustup-init" \
 && curl -fsSLo /tmp/rustup-init.sha256 "${base}/rustup-init.sha256" \
 && echo "$(cut -d' ' -f1 /tmp/rustup-init.sha256)  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
 && rm /tmp/rustup-init /tmp/rustup-init.sha256
# The repository's rust-toolchain.toml asks for "stable"; for the AppImage
# the fixed toolchain above wins, so builds are reproducible.
ENV PATH=/root/.cargo/bin:$PATH \
    RUSTUP_TOOLCHAIN=${RUST_TOOLCHAIN}
